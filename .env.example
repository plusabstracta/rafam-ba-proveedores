# Plantilla unica por roles.
#
# Perfil 1 - Operador RAFAM / export CSV:
#   Completa APP + SOURCE RAFAM. No necesita PAXAPOS_*.
#   Uso tipico: make export-rafam-csv
#
# Perfil 2 - Operador Paxapos / importacion:
#   Completa APP + SOURCE RAFAM o snapshot SQLite + LOCAL + DESTINATION Paxapos.
#   Uso tipico: make migrate-*, make migrator-spec, make migrator-lookups.

# ─── App en este servidor ────────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=DEBUG

# ─── SOURCE: RAFAM ───────────────────────────────────────────────────────────
# Obligatorio para quien exporta CSV desde RAFAM y para quien sincroniza.
# Antes: DB_BACKEND, DB_HOST, DB_PORT, DB_SERVICE, DB_USER, DB_PASSWORD, SQLITE_DB_PATH
# oracle = RAFAM real; sqlite = snapshot local de RAFAM para desarrollo/importacion offline
RAFAM_SOURCE_BACKEND=oracle

# Oracle RAFAM (usar cuando RAFAM_SOURCE_BACKEND=oracle)
RAFAM_SOURCE_HOST=192.168.x.x
RAFAM_SOURCE_PORT=1521
RAFAM_SOURCE_SERVICE=BDRAFAM
RAFAM_SOURCE_USER=usuario_lectura
RAFAM_SOURCE_PASSWORD=secreto

# Oracle Instant Client (thick mode, requerido para Oracle < 12.2).
# Si no se setea, se intenta LD_LIBRARY_PATH.
#ORACLE_CLIENT_DIR=/opt/oracle/instantclient

# Snapshot RAFAM local en este servidor (solo usar con RAFAM_SOURCE_BACKEND=sqlite)
RAFAM_SOURCE_SQLITE_DB_PATH=state/dev_rafam.db

# ─── LOCAL: estado del script ────────────────────────────────────────────────
# Requerido para main.py run/status/reset porque guarda avance incremental y links.
# No hace falta para scripts/export_last_3_months.py si solo se generan CSV desde RAFAM.
# Guarda checkpoints + vínculos RAFAM -> Paxapos en una sola SQLite.
# Antes: CHECKPOINT_DB_PATH/ENTITY_LINK_DB_PATH, luego LOCAL_CHECKPOINT_DB_PATH/LOCAL_ENTITY_LINK_DB_PATH.
LOCAL_STATE_DB_PATH=state/checkpoint.db

# ─── DESTINATION: Paxapos / Portal de Proveedores ────────────────────────────
# Opcional. Completar solo si este entorno envia/importa datos a Paxapos.
# No es necesario para el perfil RAFAM-only que genera CSVs.
# Antes: GATEWAY_URL, GATEWAY_TENANT, GATEWAY_JWT, GATEWAY_VERIFY_SSL, GATEWAY_TIMEOUT_SECONDS,
#        MIGRATOR_BASE_URL, MIGRATOR_TENANT, MIGRATOR_API_KEY, MIGRATOR_VERIFY_SSL, MIGRATOR_TIMEOUT_SECONDS
PAXAPOS_URL=
PAXAPOS_TENANT=
PAXAPOS_VERIFY_SSL=true
# Timeout del cliente. Debe superar el timeout del proxy/gateway; no controla nginx.
PAXAPOS_TIMEOUT_SECONDS=120
PAXAPOS_API_KEY=

# Rutas RAFAM dentro de Paxapos: {PAXAPOS_URL}/{PAXAPOS_TENANT}/{PAXAPOS_RAFAM_*_PATH}.
# Antes: MIGRATOR_IMPORT_ENDPOINT/MIGRATOR_SPEC_ENDPOINT/MIGRATOR_LOOKUPS_ENDPOINT.
PAXAPOS_RAFAM_IMPORT_PATH=rafam/migracion/importar.json
PAXAPOS_RAFAM_SPEC_PATH=rafam/migracion/spec.json
PAXAPOS_RAFAM_LOOKUPS_PATH=rafam/migracion/lookups.json
PAXAPOS_RAFAM_RESOLVER_MERCADERIA_PATH=rafam/migracion/resolver_mercaderia.json
PAXAPOS_RAFAM_RESOLVER_GASTO_PATH=rafam/migracion/resolver_gasto.json

# IDs default de Paxapos usados cuando RAFAM no trae/mapea el valor.
# Confirmar estos IDs con make migrator-lookups antes de una importacion real.
# (La unidad de medida default NO es configurable por env: _UM_DEFAULT=5 en gateway_mapper.py.)
PAXAPOS_RAFAM_DEFAULT_TIPO_FACTURA_ID=
PAXAPOS_RAFAM_DEFAULT_TIPO_PAGO_ID=10

# Delay local del script entre batches enviados a Paxapos. Antes: MIGRATOR_BATCH_DELAY_SECONDS.
RAFAM_SYNC_BATCH_DELAY_SECONDS=2

# Tope de filas fuente por request de OCs. No parte los items de una misma OC.
RAFAM_OC_MAX_BATCH_ROWS=100

# Ejercicio mínimo: filtra TODAS las entidades con columna EJERCICIO.
# En producción usar 2026 para migrar solo datos del ejercicio 2026 en adelante.
# Dejar vacío o 0 para no filtrar (migra todos los ejercicios).
RAFAM_EJERCICIO_MIN=2026

# COD_PROV extra a EXCLUIR de la migración (además de la blocklist por defecto
# definida en src/config.py: telefonía, gas, luz, cajas chicas, organismos, etc.).
# Lista separada por comas. Estos proveedores y sus OC/OP NO se envían a Paxapos.
# Ejemplo: RAFAM_EXCLUDED_COD_PROV=51234,51235
RAFAM_EXCLUDED_COD_PROV=

# Errores parciales del migrator (207 por fila): true = la corrida falla y no
# avanza checkpoint; false (default) = loguea warning, encola las filas
# rechazadas en la retry queue y sigue.
#RAFAM_STRICT_PARTIAL_ERRORS=false

# Migrar ordenes de pago de GASTO DIRECTO (con factura real en CTA_COMPROB
# pero sin orden de compra en REG_COMP: servicios, etc.). true (default):
# se envian sin pedido_id — Paxapos crea/deduplica el Gasto por
# proveedor+factura_nro. false: solo se migran pagos respaldados por OC
# (comportamiento historico). En el snapshot 2026 esto representa ~44% de
# los pagos confirmados.
RAFAM_MIGRAR_OP_SIN_OC=true

# ─── NOTIFICACIONES: resumen diario / alertas de integridad ─────────────────
# Requeridas para `main.py daily-report` y para los emails de check_integrity.
NOTIFY_ENABLED=false
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=465
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=
NOTIFY_FROM=
NOTIFY_TO=
NOTIFY_SUBJECT_PREFIX=[RAFAM]
NOTIFY_SMTP_TIMEOUT=15

# ─── LOGS / DEBUG (opcionales) ───────────────────────────────────────────────
# Carpeta de logs rotativos mensuales (default: logs/).
#RAFAM_LOG_DIR=logs
# Path del historial de corridas para el resumen diario (default: state/run_history.jsonl).
#RAFAM_RUN_HISTORY_PATH=state/run_history.jsonl
# Dump de payloads HTTP para debugging (NUNCA en prod salvo DUMP_PAYLOAD_FORCE=1).
#DUMP_PAYLOAD=
#DUMP_PAYLOAD_FORCE=
